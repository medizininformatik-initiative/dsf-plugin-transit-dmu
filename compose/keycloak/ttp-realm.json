{
  "realm": "ttp",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,

  "roles": {
    "realm": [
      {
        "name": "role.gpas.user",
        "description": "Routine gPAS access (gpasService, gpasServiceWithNotification, Web UI as user)"
      },
      {
        "name": "role.gpas.admin",
        "description": "gPAS administration (DomainService, Web UI as admin) - implies role.gpas.user"
      }
    ]
  },

  "clients": [
    {
      "clientId": "web",
      "name": "gPAS Web UI",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "web-client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://gpas/*",
        "http://gpas:8080/*",
        "http://localhost:8080/*"
      ],
      "webOrigins": [
        "https://gpas",
        "http://gpas:8080",
        "http://localhost:8080"
      ],
      "rootUrl": "https://gpas",
      "baseUrl": "/gpas",
      "fullScopeAllowed": true
    },
    {
      "clientId": "soap",
      "name": "gPAS SOAP interface",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "soap-client-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "redirectUris": [],
      "webOrigins": [],
      "fullScopeAllowed": true
    },
    {
      "clientId": "fhir",
      "name": "gPAS FHIR gateway",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "fhir-client-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "redirectUris": [],
      "webOrigins": [],
      "fullScopeAllowed": true
    },
    {
      "clientId": "gpas-domain-admin",
      "name": "Dedicated app - gPAS domain creation",
      "description": "Machine-to-machine client for the one app that's allowed to create/manage gPAS domains via DomainService. Uses client_credentials grant only - no human login, no password.",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "domain-admin-client-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": [],
      "webOrigins": [],
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "audience-soap",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "soap",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],

  "users": [
    {
      "username": "gpas-user",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "change-me-gpas-user-password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "role.gpas.user",
        "offline_access",
        "uma_authorization"
      ]
    },
    {
      "username": "gpas-admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "change-me-gpas-admin-password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "role.gpas.user",
        "role.gpas.admin",
        "offline_access",
        "uma_authorization"
      ]
    },
    {
      "username": "service-account-gpas-domain-admin",
      "enabled": true,
      "serviceAccountClientId": "gpas-domain-admin",
      "realmRoles": [
        "role.gpas.admin"
      ]
    }
  ]
}
