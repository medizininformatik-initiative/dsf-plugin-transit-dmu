# -----------------------------------------------------------------------
# envs/ttp_gpas.env
#
# gPAS-specific settings. Variable names and semantics per
# TTP-Tools-Keycloak-Einrichtung.md and TTP-Tools-Domain-Roles.md.
# -----------------------------------------------------------------------

# --- Activate Keycloak auth per interface ---
TTP_GPAS_WEB_AUTH_MODE=keycloak
TTP_GPAS_SOAP_KEYCLOAK_ENABLE=true
TTP_DOMAIN_ADMIN_KEYCLOAK_CLIENT_ID=gpas-domain-admin
TTP_DOMAIN_ADMIN_KEYCLOAK_CLIENT_SECRET=domain-admin-client-secret

# --- SOAP client credentials (register a "soap" client in Keycloak, see README) ---
TTP_SOAP_KEYCLOAK_CLIENT_ID=soap
TTP_SOAP_KEYCLOAK_CLIENT_SECRET=soap-client-secret

# --- Web client credentials (register a "web" client in Keycloak) ---
TTP_WEB_KEYCLOAK_CLIENT_ID=web
TTP_WEB_KEYCLOAK_CLIENT_SECRET=web-client-secret

# --- Role names (defaults shown; only need to override if you renamed roles in Keycloak) ---
# TTP_SOAP_KEYCLOAK_ROLE_GPAS_USER=role.gpas.user
# TTP_SOAP_KEYCLOAK_ROLE_GPAS_ADMIN=role.gpas.admin
# TTP_FHIR_KEYCLOAK_ROLE_GPAS_USER=role.gpas.user
# TTP_FHIR_KEYCLOAK_ROLE_GPAS_ADMIN=role.gpas.admin

# --- Which SOAP endpoints require the user vs. admin role (these are the defaults) ---
TTP_GPAS_SOAP_ROLE_USER_SERVICES=/gpas/gpasService,/gpas/gpasServiceWithNotification
TTP_GPAS_SOAP_ROLE_ADMIN_SERVICES=/gpas/DomainService

# --- Role-based domain restriction (optional extra layer, on top of auth) ---
# DISABLED = everyone sees all domains
# FORCED   = only domains matching the user's ":gpas:..." roles are visible; no
#            domain roles = no domains visible
# IMPLIED  = (default if unset) only enforced for users who actually have
#            domain roles; users without any domain role see everything
TTP_GPAS_AUTH_DOMAIN_ROLES=IMPLIED

# --- Logging ---
TTP_GPAS_LOG_LEVEL=INFO
