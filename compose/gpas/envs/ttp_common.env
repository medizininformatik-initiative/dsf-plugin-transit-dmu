# -----------------------------------------------------------------------
# envs/ttp_common.env
#
# Common Keycloak connection settings (documented in
# TTP-Tools-Keycloak-Einrichtung.md, section "Verbindungseinstellungen").
# These are defaults that apply to WEB/FHIR/SOAP unless overridden by a
# more specific TTP_<INTERFACE>_KEYCLOAK_* variable in ttp_gpas.env.
# -----------------------------------------------------------------------

TZ=Europe/Berlin

# --- Keycloak realm / server ---
TTP_KEYCLOAK_REALM=ttp
TTP_KEYCLOAK_SERVER_URL=http://keycloak:8081
TTP_KEYCLOAK_SSL_REQUIRED=none
TTP_KEYCLOAK_CONFIDENTIAL_PORT=0
TTP_KEYCLOAK_USE_RESOURCE_ROLE_MAPPINGS=false

# --- FHIR gateway (shared across tools, per docs) ---
TTP_FHIR_KEYCLOAK_ENABLE=true
TTP_FHIR_KEYCLOAK_CLIENT_ID=fhir
TTP_FHIR_KEYCLOAK_CLIENT_SECRET=fhir-client-secret

# --- Logging (set to DEBUG only while troubleshooting auth) ---
WF_CONSOLE_LOG_LEVEL=INFO
TTP_FHIR_LOG_LEVEL=INFO
TTP_AUTH_LOG_LEVEL=INFO
TTP_WEB_LOG_LEVEL=INFO
